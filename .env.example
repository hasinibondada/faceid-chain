# --- Optional: Google Custom Search (recommended for most reliable results) ---
# Get a key: https://console.cloud.google.com/apis/credentials
# Create a CSE: https://cse.google.com/cse/all  (allow all sites, "Search the entire web")
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Blockchain / local chain tuning ---
# How many leading zeros the mined block hash must have (1-5; higher = slower mining)
BLOCKCHAIN_DIFFICULTY=3
# Where the JSON ledger is stored
# BLOCKCHAIN_LEDGER_PATH=data/ledger.json

# --- Optional: OpenCV DNN face detector model files ---
# Download via scripts/download_models.py
# FACE_DET_PROTO=models/deploy.prototxt
# FACE_DET_MODEL=models/res10_300x300_ssd_iter_140000.caffemodel